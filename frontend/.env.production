# Read at build time by `npm run build` (vite build). Values are baked into dist/.
#
# Empty means the API is same-origin, which matches the current deployment:
# frontend/dist is copied into backend/public, so /api/v1 resolves against the
# Laravel app itself and no CORS configuration is required.
#
# If the frontend is later split onto its own static Forge site (subdomain
# strategy in docs/DEPLOYMENT.md), set this to the API origin instead:
#   VITE_API_URL=https://api.example.com
VITE_API_URL=
