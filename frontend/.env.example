# Copy to .env (or .env.local) for local development.
#
# Leave empty to route API calls through the Vite dev proxy, which forwards /api
# to http://127.0.0.1:8000 (see vite.config.ts). Set an explicit origin only if
# you want to bypass the proxy and call the backend directly:
#   VITE_API_URL=http://localhost:8000
VITE_API_URL=
